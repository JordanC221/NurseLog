# Copy to .env only. Never commit real secrets.

PORT=3001
NODE_ENV=development
DATA_DIR=./data
STORAGE_DIR=./app-storage

# Optional: OpenAI-compatible provider key. Leave blank for unavailable AI state.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional Stripe test-mode credentials only. Leave blank to disable checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAID_STUDY_PRICE_ID=
